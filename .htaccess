# Protocolo Corpo Novo: configuração do servidor (Hostinger / Apache)

# Página inicial
DirectoryIndex index.html

# Bloqueia arquivos internos do projeto (git, agente, documentação)
RedirectMatch 404 /\.(git|claude)(/|$)
RedirectMatch 404 /(README|CLAUDE)\.md$

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache: HTML sempre atualizado, imagens e vídeos por 30 dias
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
